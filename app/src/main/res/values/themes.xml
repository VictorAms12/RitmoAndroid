    <style name="Theme.Ritmo.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#57D8AA</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#071612</item>
